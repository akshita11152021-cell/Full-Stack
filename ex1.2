<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Banking UI</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0; font-family: system-ui, sans-serif;
      background: #f0f4f8; padding: 20px;
      display: flex; justify-content: center; align-items: center;
      min-height: 100vh;
    }
    .bank-app {
      background: #fff;
      width: 100%; max-width: 400px;
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 6px 24px rgba(0,0,0,0.1);
    }
    .balance-card {
      background: linear-gradient(135deg, #4f46e5, #6366f1);
      color: #fff; padding: 20px; border-radius: 12px;
      text-align: center; margin-bottom: 20px;
    }
    .balance-card h2 { margin: 0; font-size: 1rem; opacity: .8; }
    .balance-card p { margin: 8px 0 0; font-size: 1.8rem; font-weight: 700; }
    .actions { display: flex; flex-direction: column; gap: 12px; }
    .actions input {
      padding: 12px; border: 1px solid #ccc;
      border-radius: 8px; font-size: 1rem; width: 100%;
    }
    .buttons { display: flex; gap: 12px; }
    button {
      flex: 1; padding: 12px; border: 0; border-radius: 8px;
      font-size: 1rem; font-weight: 600; cursor: pointer;
      transition: 0.2s ease;
    }
    .deposit { background: #16a34a; color: #fff; }
    .deposit:hover { background: #15803d; }
    .withdraw { background: #dc2626; color: #fff; }
    .withdraw:hover { background: #b91c1c; }
    @media (max-width: 480px) {
      .buttons { flex-direction: column; }
    }
  </style>
</head>
<body>
  <div class="bank-app">
    <div class="balance-card">
      <h2>Current Balance</h2>
      <p id="balance">$0.00</p>
    </div>

    <div class="actions">
      <input type="number" id="amount" placeholder="Enter amount" min="1" />
      <div class="buttons">
        <button class="deposit" onclick="deposit()">Deposit</button>
        <button class="withdraw" onclick="withdraw()">Withdraw</button>
      </div>
    </div>
  </div>

  <script>
    let balance = 0;

    function updateBalance() {
      document.getElementById("balance").textContent = 
        `$${balance.toFixed(2)}`;
    }

    function deposit() {
      const amt = parseFloat(document.getElementById("amount").value);
      if (!isNaN(amt) && amt > 0) {
        balance += amt;
        updateBalance();
      } else {
        alert("Enter a valid deposit amount!");
      }
      document.getElementById("amount").value = "";
    }

    function withdraw() {
      const amt = parseFloat(document.getElementById("amount").value);
      if (!isNaN(amt) && amt > 0) {
        if (amt <= balance) {
          balance -= amt;
          updateBalance();
        } else {
          alert("Insufficient balance!");
        }
      } else {
        alert("Enter a valid withdrawal amount!");
      }
      document.getElementById("amount").value = "";
    }
  </script>
</body>
</html>
